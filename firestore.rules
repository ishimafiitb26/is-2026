rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reflection Prompts - anyone can read
    match /reflection_prompts/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Reflection Notes - users can CRUD own notes
    match /reflection_notes/{document=**} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.userId;
    }

    // Attendance Records - everyone can submit own, everyone can read
    match /attendance_records/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // H1 Confirmations - everyone can submit own, everyone can read
    match /h1_confirmations/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Task Submissions - everyone can submit own, everyone can read all
    match /task_submissions/{document=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
    }

    // Tasks - everyone can read, no one can write (admin via console)
    match /tasks/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Team Tasks - everyone can read, no one can write (admin via console)
    match /team_tasks/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Assessments - everyone can read, no one can write (admin via console)
    match /assessments/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Announcements - everyone can read, authenticated can write (UI controls admin access)
    match /announcements/{document=**} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Users - authenticated users can update own profile
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
